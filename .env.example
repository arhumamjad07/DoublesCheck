# Local Zetaris only. Never put real keys in this example file.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=PASTE_LOCAL_ZETARIS_TOKEN_HERE

# Explicit Nightshift AI mode uses this local runtime and token.
# Keep the NVIDIA API key in Nightshift Providers, not in this file.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=PASTE_NIGHTSHIFT_RUNTIME_TOKEN_HERE
# Legacy demos only; the new coach pins the approved NVIDIA model.
METERLESS_MODEL=meterless/auto
# Legacy model-credit opt-in remains absent. Local/sample mode makes no model calls.
